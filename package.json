{
    "name": "widdershins-reborn",
    "version": "0.1.0",
    "description": "Convert OpenAPI / Swagger / AsyncAPI / Semoasa definitions to Markdown or HTML — for apps, docs pipelines, and static site generators",
    "main": "lib/index.js",
    "bin": {
        "widdershins-reborn": "./widdershins.js"
    },
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "lint": "npx eslint@8 *.js lib/*.js test/*.js",
        "shins": "node widdershins-reborn --discovery -o ../shins/source/index.html.md defs/petstore.json",
        "test": "nyc mocha"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sikandarsubhani/widdershins-reborn.git"
    },
    "keywords": [
        "openapi",
        "openapi3",
        "swagger",
        "asyncapi",
        "api-docs",
        "documentation",
        "markdown",
        "html",
        "slate",
        "reslate",
        "respec",
        "semoasa",
        "openapi-to-markdown",
        "swagger-to-markdown",
        "api-documentation",
        "docs-generator"
    ],
    "author": "Sikandar",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/sikandarsubhani/widdershins-reborn/issues"
    },
    "homepage": "https://github.com/sikandarsubhani/widdershins-reborn#readme",
    "engines": {
        "node": ">=20.0.0"
    },
    "files": [
        "lib",
        "templates",
        "include",
        "statusCodes.json",
        "resources",
        "widdershins.js",
        "LICENSE",
        "README.md"
    ],
    "dependencies": {
        "dot": "^1.1.3",
        "highlight.js": "^11.11.1",
        "httpsnippet": "^3.0.0",
        "jgexml": "^0.4.4",
        "markdown-it": "^14.0.0",
        "markdown-it-emoji": "^2.0.0",
        "node-fetch": "^2.6.1",
        "oas-resolver": "^2.5.6",
        "oas-schema-walker": "^1.1.5",
        "openapi-sampler": "^1.1.0",
        "pinyin": "^2.9.1",
        "reftools": "^1.1.9",
        "swagger2openapi": "^7.0.8",
        "urijs": "^1.19.2",
        "yaml": "^2.9.0",
        "yargs": "^17.7.3"
    },
    "devDependencies": {
        "mdv": "^1.3.0",
        "mocha": "^11.7.6",
        "node-readfiles": "^0.2.0",
        "nyc": "^17.1.0"
    }
}
