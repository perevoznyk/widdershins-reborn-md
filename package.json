{
  "name": "widdershins-reborn",
  "version": "0.1.5",
  "description": "Convert OpenAPI / Swagger / AsyncAPI / Semoasa definitions to Markdown or HTML — for apps, docs pipelines, and static site generators",
  "main": "lib/index.js",
  "module": "./index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./types/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "widdershins-reborn": "./widdershins.js"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node scripts/compile-templates.js",
    "lint": "npx eslint@8 *.js lib/*.js test/*.js",
    "shins": "node widdershins-reborn --discovery -o ../shins/source/index.html.md defs/petstore.json",
    "test": "nyc mocha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sikandarsubhani/widdershins-reborn.git"
  },
  "keywords": [
    "openapi",
    "openapi3",
    "openapi3.1",
    "openapi-to-markdown",
    "openapi-to-html",
    "oas",
    "oas3",
    "swagger",
    "swagger-to-markdown",
    "swagger2",
    "asyncapi",
    "asyncapi2",
    "asyncapi-to-markdown",
    "api-docs",
    "api-reference",
    "api-documentation",
    "documentation",
    "docs-generator",
    "reference-docs",
    "rest-api",
    "markdown",
    "html",
    "slate",
    "redoc",
    "reslate",
    "respec",
    "semoasa",
    "converter",
    "generator",
    "cli",
    "nodejs",
    "node",
    "npm",
    "library"
  ],
  "author": "Sikandar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sikandarsubhani/widdershins-reborn/issues"
  },
  "homepage": "https://github.com/sikandarsubhani/widdershins-reborn#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "lib",
    "types",
    "index.mjs",
    "templates",
    "include",
    "statusCodes.json",
    "resources",
    "widdershins.js",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "dot": "^1.1.3",
    "highlight.js": "^11.11.1",
    "httpsnippet": "^3.0.0",
    "jgexml": "^0.4.4",
    "markdown-it": "^14.0.0",
    "markdown-it-emoji": "^2.0.0",
    "oas-resolver": "^2.5.6",
    "oas-schema-walker": "^1.1.5",
    "openapi-sampler": "^1.1.0",
    "pinyin": "^4.0.0",
    "reftools": "^1.1.9",
    "swagger2openapi": "^7.0.8",
    "urijs": "^1.19.2",
    "yaml": "^2.9.0",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "mocha": "^11.7.6",
    "node-readfiles": "^0.2.0",
    "nyc": "^18.0.0"
  },
  "overrides": {
    "httpsnippet": {
      "form-data": "^4.0.6"
    },
    "mocha": {
      "serialize-javascript": "^7.0.7",
      "diff": "^8.0.4",
      "minimatch": {
        "brace-expansion": "^5.0.8"
      }
    }
  }
}
